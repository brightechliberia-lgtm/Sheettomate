generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
  USER
  LEARNER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  ORANGE_MONEY
  MOBILE_MONEY
  BANFFPAY_VISA
  MTN_MOMO
  WALLET
}

enum PaymentPurpose {
  TEMPLATE
  WALLET_TOPUP
  COURSE
}

enum AIRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  PRACTICE
  PROJECT
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum StaffRole {
  SUPER
  CONTENT
  COMMUNITY
  FINANCE
}

enum TemplateReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  passwordHash     String    @map("password_hash")
  googleId         String?   @unique @map("google_id")
  avatarUrl        String?   @map("avatar_url")
  role             Role      @default(USER)
  country          String?
  phone            String?
  emailVerifiedAt  DateTime? @map("email_verified_at")
  staffRole        StaffRole? @map("staff_role")
  suspendedAt      DateTime? @map("suspended_at")
  lastLoginAt      DateTime? @map("last_login_at")
  walletUsd        Decimal   @default(0) @map("wallet_usd") @db.Decimal(12, 2)
  walletLrd        Decimal   @default(0) @map("wallet_lrd") @db.Decimal(12, 2)
  bio              String?
  expertise        String[]  @default([])
  reputation       Int       @default(0)
  loginStreak      Int       @default(0) @map("login_streak")
  learnStreak      Int       @default(0) @map("learn_streak")
  lastSeenOn       DateTime? @map("last_seen_on")
  lastLearnOn      DateTime? @map("last_learn_on")
  digestOptIn      Boolean   @default(true) @map("digest_opt_in")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  templates         Template[]          @relation("CreatedTemplates")
  instructedCourses Course[]            @relation("CourseInstructor")
  downloads         TemplateDownload[]
  enrollments       CourseEnrollment[]
  payments          Payment[]
  aiRequests        AIRequest[]
  refreshTokens     RefreshToken[]
  authTokens        AuthToken[]
  ratings           TemplateRating[]
  questions         TemplateQuestion[]
  answers           TemplateAnswer[]
  downloadTokens    DownloadToken[]
  cartItems         CartItem[]
  walletLedgers     WalletLedger[]
  lessonProgress    LessonProgress[]
  lessonBookmarks   LessonBookmark[]
  lessonNotes       LessonNote[]
  lessonQuestions   LessonQuestion[]
  lessonAnswers     LessonAnswer[]
  courseRatings     CourseRating[]
  certificates      Certificate[]
  notifications     Notification[]
  projectSubmissions ProjectSubmission[]
  pushSubscriptions  PushSubscription[]
  contentFlags       ContentFlag[]
  cmsPages           CmsPage[]           @relation("CmsAuthor")
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  following          Follow[]            @relation("Following")
  followers          Follow[]            @relation("Followers")
  templateLikes      TemplateLike[]
  templateComments   TemplateComment[]
  endorsementsGiven  Endorsement[]       @relation("EndorsementsGiven")
  endorsementsRecv   Endorsement[]       @relation("EndorsementsReceived")
  badges             UserBadge[]
  activities         Activity[]
  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  forumVotes         ForumVote[]
  weeklyVotes        WeeklyVote[]
  challengeEntries   ChallengeEntry[]
  workspacesOwned    Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]
  templateVersions   TemplateVersion[]
  eventRsvps         EventRsvp[]
  workflows          AutomationWorkflow[]
  outboundWebhooks   OutboundWebhook[]
  inboundHooks       InboundHook[]
  apiKeys            ApiKey[]
  oauthConnections   OAuthConnection[]
  automationEvents   AutomationEvent[]

  @@map("users")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  tokenHash String        @map("token_hash")
  type      AuthTokenType
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash, type])
  @@index([userId])
  @@map("auth_tokens")
}

model Template {
  id                String   @id @default(uuid())
  title             String
  description       String
  category          String
  tags              String[] @default([])
  price             Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  fileUrl           String   @map("file_url")
  fileKey           String?  @map("file_key")
  previewUrl        String?  @map("preview_url")
  previewKey        String?  @map("preview_key")
  demoUrl           String?  @map("demo_url")
  videoTutorial     String?  @map("video_tutorial")
  rows              Int?
  columns           Int?
  softwareRequired  String   @default("Excel / Google Sheets") @map("software_required")
  version           String   @default("1.0")
  language          String   @default("en")
  downloadCount     Int      @default(0) @map("download_count")
  averageRating     Float    @default(0) @map("average_rating")
  ratingCount       Int      @default(0) @map("rating_count")
  published         Boolean  @default(true)
  featured          Boolean  @default(false)
  reviewStatus      TemplateReviewStatus @default(APPROVED) @map("review_status")
  flagged           Boolean  @default(false)
  flagReason        String?  @map("flag_reason")
  createdById       String   @map("created_by")
  isAiGenerated     Boolean  @default(false) @map("is_ai_generated")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  createdBy      User               @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: Restrict)
  downloads      TemplateDownload[]
  aiRequests     AIRequest[]
  ratings        TemplateRating[]
  questions      TemplateQuestion[]
  downloadTokens DownloadToken[]
  cartItems      CartItem[]
  likes          TemplateLike[]
  comments       TemplateComment[]
  versions       TemplateVersion[]
  weeklyVotes    WeeklyVote[]
  challengeEntries ChallengeEntry[]
  workspaceLinks WorkspaceTemplate[]

  @@index([category])
  @@index([createdById])
  @@index([published])
  @@index([featured])
  @@index([reviewStatus])
  @@map("templates")
}

model TemplateRating {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
  @@map("template_ratings")
}

model TemplateQuestion {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  TemplateAnswer[]

  @@index([templateId])
  @@map("template_questions")
}

model TemplateAnswer {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  question TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("template_answers")
}

model DownloadToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  templateId String    @map("template_id")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("download_tokens")
}

model CartItem {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@map("cart_items")
}

model TemplateDownload {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  templateId   String   @map("template_id")
  downloadDate DateTime @default(now()) @map("download_date")
  paymentId    String?  @map("payment_id")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, templateId, paymentId])
  @@index([templateId])
  @@map("template_downloads")
}

model Course {
  id             String       @id @default(uuid())
  slug           String       @unique
  title          String
  description    String
  category       String?
  level          CourseLevel
  price          Decimal      @db.Decimal(12, 2)
  currency       String       @default("USD")
  thumbnailUrl   String?      @map("thumbnail_url")
  objectives     String[]     @default([])
  prerequisites  String       @default("")
  status         CourseStatus @default(DRAFT)
  featured       Boolean      @default(false)
  rejectionReason String?     @map("rejection_reason")
  promoPercent   Int          @default(0) @map("promo_percent")
  averageRating  Float        @default(0) @map("average_rating")
  ratingCount    Int          @default(0) @map("rating_count")
  instructorId   String       @map("instructor_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  instructor   User                 @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  enrollments  CourseEnrollment[]
  lessons      Lesson[]
  ratings      CourseRating[]
  certificates Certificate[]
  promotions   CoursePromotion[]
  paymentItems PaymentItem[]

  @@index([instructorId])
  @@index([status])
  @@index([featured])
  @@map("courses")
}

model Lesson {
  id                 String     @id @default(uuid())
  courseId           String     @map("course_id")
  sortOrder          Int        @default(0) @map("sort_order")
  title              String
  moduleTitle        String?    @map("module_title")
  type               LessonType
  content            String     @default("")
  videoUrl           String?    @map("video_url")
  videoProvider      String?    @map("video_provider")
  durationSec        Int        @default(0) @map("duration_sec")
  quiz               Json?
  practiceTemplateId String?    @map("practice_template_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources    LessonResource[]
  progress     LessonProgress[]
  bookmarks    LessonBookmark[]
  notes        LessonNote[]
  questions    LessonQuestion[]
  submissions  ProjectSubmission[]

  @@index([courseId, sortOrder])
  @@map("lessons")
}

model LessonResource {
  id       String @id @default(uuid())
  lessonId String @map("lesson_id")
  title    String
  url      String
  kind     String @default("file")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_resources")
}

model CourseEnrollment {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  courseId         String    @map("course_id")
  enrollmentDate   DateTime  @default(now()) @map("enrollment_date")
  progress         Int       @default(0)
  lastLessonId     String?   @map("last_lesson_id")
  completedAt      DateTime? @map("completed_at")
  reminderSentAt   DateTime? @map("reminder_sent_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  lessonId     String    @map("lesson_id")
  completed    Boolean   @default(false)
  positionSec  Int       @default(0) @map("position_sec")
  completedAt  DateTime? @map("completed_at")
  quizScore    Int?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model LessonBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_bookmarks")
}

model LessonNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

model LessonQuestion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers LessonAnswer[]

  @@index([lessonId])
  @@map("lesson_questions")
}

model LessonAnswer {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lesson_answers")
}

model ProjectSubmission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  notes     String
  fileUrl   String?  @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("project_submissions")
}

model CourseRating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_ratings")
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  code      String   @unique
  issuedAt  DateTime @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

model CoursePromotion {
  id         String    @id @default(uuid())
  courseId   String    @map("course_id")
  code       String
  percentOff Int       @map("percent_off")
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  active     Boolean   @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, code])
  @@map("course_promotions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Payment {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  amount          Decimal         @db.Decimal(12, 2)
  amountUsd       Decimal         @map("amount_usd") @db.Decimal(12, 2)
  amountLrd       Decimal         @map("amount_lrd") @db.Decimal(12, 2)
  fxRate          Decimal         @map("fx_rate") @db.Decimal(12, 4)
  currency        String          @default("USD")
  status          PaymentStatus   @default(PENDING)
  gateway         PaymentGateway
  provider        String          @default("BANFFPAY")
  purpose         PaymentPurpose  @default(TEMPLATE)
  description     String?
  phone           String?
  reference       String          @unique
  transactionId   String?         @unique @map("transaction_id")
  checkoutUrl     String?         @map("checkout_url")
  ussdCode        String?         @map("ussd_code")
  qrPayload       String?         @map("qr_payload")
  failureReason   String?         @map("failure_reason")
  idempotencyKey  String?         @unique @map("idempotency_key")
  verifiedAt      DateTime?       @map("verified_at")
  rawPayload      Json?           @map("raw_payload")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads TemplateDownload[]
  items     PaymentItem[]
  events    PaymentEvent[]
  ledgers   WalletLedger[]

  @@index([userId])
  @@index([status])
  @@index([reference])
  @@map("payments")
}

model PaymentItem {
  id         String  @id @default(uuid())
  paymentId  String  @map("payment_id")
  templateId String? @map("template_id")
  courseId   String? @map("course_id")
  title      String
  amountUsd  Decimal @map("amount_usd") @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("payment_items")
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model WalletLedger {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  paymentId   String?  @map("payment_id")
  currency    String
  delta       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("wallet_ledgers")
}

model AIRequest {
  id                   String          @id @default(uuid())
  userId               String          @map("user_id")
  prompt               String
  category             String?
  industry             String?
  parentRequestId      String?         @map("parent_request_id")
  generatedTemplateId  String?         @map("generated_template_id")
  status               AIRequestStatus @default(PENDING)
  progress             String          @default("queued")
  errorMessage         String?         @map("error_message")
  feedback             String?
  tokensUsed           Int             @default(0) @map("tokens_used")
  costUsd              Decimal         @default(0) @map("cost_usd") @db.Decimal(10, 4)
  specJson             Json?           @map("spec_json")
  publishedAt          DateTime?       @map("published_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedTemplate Template? @relation(fields: [generatedTemplateId], references: [id], onDelete: SetNull)
  parent            AIRequest?  @relation("AiRefinements", fields: [parentRequestId], references: [id], onDelete: SetNull)
  refinements       AIRequest[] @relation("AiRefinements")

  @@index([userId])
  @@index([status])
  @@map("ai_requests")
}

model AIPromptTemplate {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  category     String
  industry     String
  examplePrompt String  @map("example_prompt")
  systemPrompt String   @map("system_prompt")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("ai_prompt_templates")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model ContentFlag {
  id         String     @id @default(uuid())
  reporterId String     @map("reporter_id")
  targetType String     @map("target_type")
  targetId   String     @map("target_id")
  reason     String
  status     FlagStatus @default(OPEN)
  createdAt  DateTime   @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@map("content_flags")
}

model CmsPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  body        String
  published   Boolean  @default(false)
  authorId    String   @map("author_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  author User @relation("CmsAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("cms_pages")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  published Boolean  @default(true)
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("announcements")
}

model ScheduledReport {
  id         String    @id @default(uuid())
  email      String
  cadence    String
  reportType String    @map("report_type")
  active     Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("scheduled_reports")
}

model ErrorEvent {
  id        String   @id @default(uuid())
  source    String
  message   String
  stack     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_events")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("newsletter")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Follow {
  followerId  String @map("follower_id")
  followingId String @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model TemplateLike {
  userId     String @map("user_id")
  templateId String @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@index([templateId])
  @@map("template_likes")
}

model TemplateComment {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  userId     String   @map("user_id")
  parentId   String?  @map("parent_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  template Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   TemplateComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  TemplateComment[] @relation("CommentThread")

  @@index([templateId])
  @@map("template_comments")
}

model Endorsement {
  fromUserId String @map("from_user_id")
  toUserId   String @map("to_user_id")
  skill      String
  createdAt  DateTime @default(now()) @map("created_at")

  from User @relation("EndorsementsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("EndorsementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@id([fromUserId, toUserId, skill])
  @@index([toUserId])
  @@map("endorsements")
}

model UserBadge {
  userId    String   @map("user_id")
  badge     String
  awardedAt DateTime @default(now()) @map("awarded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badge])
  @@map("user_badges")
}

model Activity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  body      String
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("activities")
}

model ForumPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([createdAt])
  @@map("forum_posts")
}

model ForumReply {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  post    ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ForumReply?  @relation("ForumThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies ForumReply[] @relation("ForumThread")
  votes   ForumVote[]

  @@index([postId])
  @@map("forum_replies")
}

model ForumVote {
  userId  String @map("user_id")
  replyId String @map("reply_id")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@map("forum_votes")
}

model WeeklyVote {
  weekKey    String @map("week_key")
  userId     String @map("user_id")
  templateId String @map("template_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([weekKey, userId])
  @@index([weekKey, templateId])
  @@map("weekly_votes")
}

model CommunityEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  meetingUrl  String?  @map("meeting_url")
  createdAt   DateTime @default(now()) @map("created_at")

  entries ChallengeEntry[]
  rsvps   EventRsvp[]

  @@map("community_events")
}

model ChallengeEntry {
  eventId    String  @map("event_id")
  userId     String  @map("user_id")
  templateId String? @map("template_id")
  notes      String?

  event    CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@id([eventId, userId])
  @@map("challenge_entries")
}

model EventRsvp {
  eventId String @map("event_id")
  userId  String @map("user_id")

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_rsvps")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner     User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  templates WorkspaceTemplate[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  role        String @default("EDITOR")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceTemplate {
  workspaceId String @map("workspace_id")
  templateId  String @map("template_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([workspaceId, templateId])
  @@map("workspace_templates")
}

model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  createdById String  @map("created_by")
  version    String
  note       String?
  fileUrl    String   @map("file_url")
  createdAt  DateTime @default(now()) @map("created_at")

  template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_versions")
}

model AutomationWorkflow {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  description   String   @default("")
  templateSlug  String?  @map("template_slug")
  enabled       Boolean  @default(true)
  triggerType   String   @map("trigger_type")
  triggerConfig Json     @default("{}") @map("trigger_config")
  steps         Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId])
  @@index([enabled, triggerType])
  @@map("automation_workflows")
}

model AutomationRun {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  status     String
  payload    Json     @default("{}")
  result     Json?
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@map("automation_runs")
}

model OutboundWebhook {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  url       String
  secret    String
  events    String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String   @map("webhook_id")
  event        String
  requestBody  String   @map("request_body")
  statusCode   Int?     @map("status_code")
  error        String?
  attempts     Int      @default(1)
  success      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model InboundHook {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  workflowId String?  @map("workflow_id")
  token      String   @unique
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("inbound_hooks")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  keyHash    String    @unique @map("key_hash")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model OAuthConnection {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  scopes       String[] @default([])
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_connections")
}

model AutomationEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  stream    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([stream])
  @@map("automation_events")
}
