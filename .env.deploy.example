# Local Namecheap / cPanel FTP credentials for frontend deploy.
# Copy to .env.deploy and fill in (never commit .env.deploy).
#
# In cPanel: FTP Accounts → create an account limited to public_html if possible.
# Host is often your server name (e.g. business166.web-hosting.com) or ftp.sheettomate.com

FTP_HOST=business166.web-hosting.com
FTP_USER=
FTP_PASS=
FTP_PORT=21
# Remote folder relative to the FTP account root. Full cPanel user: public_html
# FTP account whose home is already public_html: leave empty or use .
FTP_REMOTE_DIR=public_html
# Production API for the Vite build
VITE_API_URL=https://api.sheettomate.com/api
