# Copy to .env in the repo root and/or server/.env

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://sheetomate:sheetomate@localhost:5432/sheetomate?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage: "s3" | "cloudinary" | "local"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sheettomate-templates

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments — PAYMENTS_MODE=sandbox uses mock BanffPay/Orange (no card data stored)
PAYMENTS_MODE=sandbox
PUBLIC_API_URL=http://localhost:4000
FX_USD_LRD=190
BANFFPAY_BASE_URL=https://api.banffpay.com/v1
BANFFPAY_API_KEY=
BANFFPAY_WEBHOOK_SECRET=dev-banffpay-webhook-secret
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_WEBHOOK_SECRET=
# Set true to route Orange Money through BanffPay instead of Orange's webpay API
ORANGE_VIA_BANFFPAY=false
MOBILE_MONEY_API_KEY=

# AI — set at least one key for live workbook generation (otherwise ExcelJS starters are used)
# AI_PROVIDER=auto|openai|anthropic|fallback
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4000
# Set AI_ALLOW_FALLBACK=false to fail hard when LLM APIs error (no starter template)
AI_ALLOW_FALLBACK=true
AI_DAILY_LIMIT_USER=8
AI_DAILY_LIMIT_CREATOR=25
AI_DAILY_LIMIT_ADMIN=100

# Logging
LOG_LEVEL=info

# Email — prefer Resend HTTPS (set RESEND_API_KEY). SMTP_* still works as fallback.
# Railway often blocks outbound SMTP (connection timeout on port 465/587).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sheettomate <noreply@sheettomate.com>

# Redis (optional — in-memory cache is used when Redis is down)
REDIS_URL=redis://localhost:6379

# CDN origin for public template assets
CDN_BASE_URL=

# Optional: Sentry DSN for API 500 capture (browser uses VITE_SENTRY_DSN)
SENTRY_DSN=

# Newsletter (optional — emails still stored locally and welcome mail is logged)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@sheettomate.com

# Automations (optional — sandbox connectors log instead of calling vendors)
SENDGRID_API_KEY=
MAILGUN_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
SLACK_WEBHOOK_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
HUBSPOT_TOKEN=
SALESFORCE_URL=
# SMTP empty = no real inbox delivery. Register still shows a clickable verify link locally.
# For Gmail, set SMTP_HOST (e.g. smtp.gmail.com), SMTP_USER, SMTP_PASS (app password).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: auto-create Google Sheets when creators tick the upload option
GOOGLE_SHEETS_REFRESH_TOKEN=
# Preferred (Railway): paste the entire service-account JSON key on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or split fields:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# Required for service accounts (they have no Drive quota):
# 1) Create a Drive folder, share it with the SA email as Editor
# 2) Copy folder ID from https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=
# Google Cloud Console → enable Sheets API + Drive API
# Authorized redirect URI (login OAuth, separate from Sheets SA):
#   https://api.sheettomate.com/api/auth/google/callback

# Observability (production)
DD_API_KEY=
DD_SITE=datadoghq.com
NEW_RELIC_LICENSE_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_GA_ID=
# Lighthouse CI target
LHCI_URL=https://staging.sheettomate.com

